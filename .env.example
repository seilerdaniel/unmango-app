# =============================================================
# UnMango — variables de entorno
#
# Copiá este archivo a `.env.local` y completá los valores:
#   copy .env.example .env.local
# (o en PowerShell:  Copy-Item .env.example .env.local)
# =============================================================

# Supabase (obligatorias para que la app funcione).
# Las encontrás en Supabase Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://pkiwbybfjstktvaxloou.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<tu-anon-key>

# --- Solo para desarrollo local de Edge Functions (supabase start) ---
# Se leen vía env() en supabase/config.toml para emular el login social
# con los mismos credenciales de OAuth. Opcionales: si no las definís,
# el provider queda deshabilitado en el entorno local.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_URL=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# =============================================================
# Secrets de las Edge Functions — NO van en archivos .env:
# se setean en el proyecto real con la CLI de Supabase:
#
#   supabase secrets set TELEGRAM_BOT_TOKEN=...
#   supabase secrets set TELEGRAM_WEBHOOK_SECRET=...
#   supabase secrets set RESEND_API_KEY=...
#   supabase secrets set REMINDER_FROM_EMAIL=...
#   supabase secrets set CRON_SECRET=...
#   supabase secrets set GOOGLE_CLIENT_ID=...
#   supabase secrets set GOOGLE_CLIENT_SECRET=...
#   supabase secrets set MERCADOPAGO_ACCESS_TOKEN=...
#   supabase secrets set MERCADOPAGO_PRO_PRICE_ARS=...    (opcional, default 12000)
#   supabase secrets set MERCADOPAGO_HOGAR_PRICE_ARS=...  (opcional, default 35000)
#   supabase secrets set APP_URL=...                      (opcional, default https://unmango.app)
#
# Referencia por función:
#   - telegram-webhook:       TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET
#   - send-renewal-reminders: RESEND_API_KEY, REMINDER_FROM_EMAIL, CRON_SECRET
#   - sync-google-calendar:   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
#   - mercadopago-checkout:   MERCADOPAGO_ACCESS_TOKEN
#   - mercadopago-webhook:    MERCADOPAGO_ACCESS_TOKEN
#
# El webhook de Telegram se consulta/setea con el script helper
# (scripts/telegram-webhook.mjs), que lee el token del env var
# TELEGRAM_BOT_TOKEN (ver supabase/functions/telegram-webhook/README.md).
#
# Guías paso a paso en los README de cada carpeta:
#   supabase/functions/telegram-webhook/README.md
#   supabase/functions/send-renewal-reminders/README.md
#   supabase/functions/sync-google-calendar/README.md
# =============================================================
